# OpenAI
OPENAI_API_KEY=

# Firecrawl (https://firecrawl.dev)
FIRECRAWL_API_KEY=

# Google Sheets + Drive (OAuth 2.0 Client - acts as your own Google account)
# CLIENT_ID / CLIENT_SECRET come from the OAuth client in Google Cloud Console.
# REFRESH_TOKEN is obtained once by running: npm run google:auth
# (the same client/refresh token is reused for Drive uploads - see README)
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REFRESH_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Google Drive folder ID that generated reports are uploaded into
GOOGLE_DRIVE_FOLDER_ID=
